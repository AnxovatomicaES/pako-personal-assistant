{
  "name": "pako",
  "version": "0.3.9",
  "description": "Pako: a personal AI assistant that runs on your own computer, with Claude as its brain. Chat, memory, reminders, mail, calendar, Slack, tables, phone. No key needed to start.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "node bin/preflight.cjs",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "predev": "node bin/preflight.cjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "panel": "node bin/panel.cjs",
    "autostart": "node --disable-warning=ExperimentalWarning src/server.ts --autostart",
    "mac-app": "sh desktop/mac/build.sh",
    "mac-release": "sh desktop/mac/release.sh",
    "mac-release-check": "sh desktop/mac/release-check.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "TZ=Europe/Madrid sh bin/with-tmp.sh node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:zones": "sh bin/zone-tests.sh",
    "check": "npm run typecheck && npm test",
    "gate": "sh bin/gate.sh",
    "bench:latency": "node --disable-warning=ExperimentalWarning test/bench/latency.ts",
    "evals:live": "node --disable-warning=ExperimentalWarning test/evals/live.ts",
    "evals:weekly": "node --disable-warning=ExperimentalWarning test/evals/weekly.ts",
    "evals:from-feedback": "node --disable-warning=ExperimentalWarning test/evals/from-feedback.ts",
    "beta:report": "node --disable-warning=ExperimentalWarning test/evals/beta-report.ts",
    "eval:live": "node --disable-warning=ExperimentalWarning test/evals/chat-live.ts",
    "eval:promote": "node --disable-warning=ExperimentalWarning test/evals/promote.ts",
    "evals:promote": "node --disable-warning=ExperimentalWarning test/evals/promote.ts",
    "nightly-install": "sh bin/nightly-install.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.3",
    "gsap": "^3.15.1",
    "ical.js": "2.2.1",
    "imapflow": "2.10.0",
    "livekit-server-sdk": "^2.19.3",
    "lucide": "^1.73.0",
    "three": "^0.187.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnxovatomicaES/pako-personal-assistant.git"
  },
  "keywords": [
    "assistant",
    "ai",
    "claude",
    "personal-assistant",
    "whatsapp",
    "local-first",
    "self-hosted"
  ],
  "homepage": "https://github.com/AnxovatomicaES/pako-personal-assistant#readme",
  "bugs": {
    "url": "https://github.com/AnxovatomicaES/pako-personal-assistant/issues"
  }
}
