<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundled node (Contents/Resources/node/bin/node) under the hardened runtime: only what V8 needs to compile JavaScript at run time.
  Checked on an Intel Mac with Node 22.23.5 signed `codesign -o runtime`: with no entitlement it aborts at its first compiled function
  (V8 "Check failed: 12 == (*__error())" in OS::SetPermissions); allow-jit alone also aborts there on Intel (V8 maps code pages
  read-write-execute, not MAP_JIT); allow-unsigned-executable-memory alone runs. On Apple silicon V8 uses MAP_JIT, which needs allow-jit.
  One universal binary runs both slices, so both stay. Nothing else of Node's own release set: no get-task-allow (notarization refuses
  it), no disable-library-validation (no .node addon is bundled: package.sh fails the build if one appears), no dyld variables.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
